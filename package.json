{
  "name": "bilingo",
  "version": "0.2.0",
  "private": true,
  "description": "Bilingual web page translation extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dom-chromium-ai": "^0.0.18",
    "@wxt-dev/module-svelte": "^2.0.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.1.5",
    "vitest": "^5.1.2",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@lucide/svelte": "^1.82.0",
    "@webext-core/messaging": "^4.0.2",
    "idb": "^8.0.4"
  }
}
